; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="qtftp2"
run/main_scene="uid://b2tdr58yk8m23"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://5s5873fvwc5y"
general/default_playback_type.web=0

[autoload]

EstadoDeJogo="*res://Scripts/EstadoDeJogo.gd"
Globais="*res://Scripts/Globais.gd"
Constantes="*res://Scripts/Constantes.gd"
Eventos="*res://Scripts/Eventos.gd"
GuiTransitions="*res://addons/simple-gui-transitions/singleton.gd"
ControleDeFase="*res://Scripts/ControleDeFase.gd"
ControleDeAudio="*res://Scripts/ControleDeAudio.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
SaveService="*res://addons/saveEngine/scripts/SaveService.gd"
Cutscene="*res://Scripts/cutscene.gd"

[dialogic]

directories/dch_directory={
"carolina": "res://Dialogo/carolina.dch",
"celular": "res://Dialogo/celular.dch",
"elza": "res://Dialogo/elza.dch",
"lucas": "res://Dialogo/lucas.dch",
"narrador": "res://Dialogo/narrador.dch"
}
